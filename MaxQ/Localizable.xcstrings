    },
    "Max Q couldn't find a place called “%@”." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Max Q n’a trouvé aucun lieu appelé « %@ »."
          }
        }
      }
    },
    "Max Q didn't find bookmarks or history there. Choose %@'s own folder: it's already open in the panel." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Max Q n’a trouvé ni signets ni historique ici. Choisissez le dossier de %@ : il est déjà ouvert dans la fenêtre."
          }
        }
      }
    },
    "Max Q didn't find bookmarks or history there. Choose the folder Safari exported (or the files in it)." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Max Q n’a trouvé ni signets ni historique ici. Choisissez le dossier exporté par Safari (ou les fichiers qu’il contient)."
          }
        }
      }
    },
    "Max Q has no window open." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Max Q n’a aucune fenêtre ouverte."
          }
        }
      }
    },
    "Max Q has spent %@ of the %@ you set for %@. Grok's answers wait for you until the month ends." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Max Q has spent %1$@ of the %2$@ you set for %3$@. Grok's answers wait for you until the month ends."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Max Q a dépensé %1$@ sur les %2$@ prévus pour %3$@. Les réponses de Grok attendent votre accord jusqu’à la fin du mois."
          }
        }
      }
    },
    "Max Q is an independent open-source browser, not affiliated with SpaceXAI or X Corp." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Max Q est un navigateur open source indépendant, sans lien avec SpaceXAI ni X Corp."
          }
        }
      }
    },
    "Max Q is an independent open-source project, not affiliated with SpaceXAI or X Corp." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Max Q est un projet open source indépendant, sans lien avec SpaceXAI ni X Corp."
          }
        }
      }
    },
    "Max Q is an independent open-source project. It is not affiliated with, endorsed by, or sponsored by SpaceXAI, xAI, X Corp., SpaceX, Brave or DuckDuckGo. Grok, Grokipedia, Grok Bot, X, Brave and DuckDuckGo are trademarks of their respective owners and are used here only to name the services Max Q works with." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Max Q est un projet open source indépendant. Il n’est ni affilié à SpaceXAI, xAI, X Corp., SpaceX, Brave ou DuckDuckGo, ni approuvé ou sponsorisé par eux. Grok, Grokipedia, Grok Bot, X, Brave et DuckDuckGo sont des marques de leurs propriétaires respectifs, utilisées ici seulement pour nommer les services avec lesquels Max Q fonctionne."
          }
        }
      }
    },
    "Max Q is your default browser" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Max Q est votre navigateur par défaut"
          }
        }
      }
    },
    "Max Q looks for news and posts on X about the search while it's open, and shows what's new in the sidebar." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Max Q cherche des actualités et des posts sur X à propos de la recherche tant qu’il est ouvert, et montre les nouveautés dans la barre latérale."
          }
        }
      }
    },
    "Max Q puts Grok's answer, web results, Grokipedia and posts from X on one page. A classic engine opens its own page, with Grokipedia beside it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Max Q réunit la réponse de Grok, les résultats web, Grokipedia et des posts de X sur une seule page. Un moteur classique ouvre sa propre page, avec Grokipedia à côté."
          }
        }
      }
    },
    "Max Q reads one article page per topic search, never Grokipedia's API, and links back to the full article. Private windows only look things up when you ask." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Max Q lit une page d’article par recherche de sujet, jamais l’API de Grokipedia, et renvoie vers l’article complet. Les fenêtres privées ne cherchent que si vous le demandez."
          }
        }
      }
    },
    "Max Q search" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recherche Max Q"
          }
        }
      }
    },
    "Max Q shows web results, pictures and videos from the Brave Search API, with your own key, which Brave gives with a free account. Until there's one, this search opens on DuckDuckGo." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Max Q affiche les résultats web, les images et les vidéos de l’API Brave Search, avec votre propre clé, que Brave fournit avec un compte gratuit. En attendant, cette recherche s’ouvre sur DuckDuckGo."
          }
        }
      }
    },
    "Max Q's results page gets web results, pictures, videos and news from the Brave Search API, with your own key. A free Brave account comes with monthly credit for about a thousand searches. Without a key, those searches open on DuckDuckGo." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La page de résultats de Max Q tire ses résultats web, images, vidéos et actualités de l’API Brave Search, avec votre propre clé. Un compte Brave gratuit comprend un crédit mensuel d’environ mille recherches. Sans clé, ces recherches s’ouvrent sur DuckDuckGo."
          }
        }
      }
    },
