    "You, search, browsing, spaces, iCloud, setup, appearance and startup." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous, la recherche, la navigation, les espaces, iCloud, la configuration, l’apparence et le démarrage."
