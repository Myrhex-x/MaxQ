    "Your answer" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre réponse"
          }
        }
      }
    },
    "Your API keys stay in your Keychain. History, tabs and settings stay on this Mac." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos clés API restent dans votre trousseau. L’historique, les onglets et les réglages restent sur ce Mac."
          }
        }
      }
    },
    "Your Bot has its own email inbox. Ask your Bot to claim it, then paste the address here." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre Bot a sa propre boîte de réception. Demandez-lui de la réclamer, puis collez l’adresse ici."
          }
        }
      }
    },
    "Your Bot has its own inbox on mail.grokbot.com. If it doesn't have one yet, ask it to claim one, then paste the address here. Max Q offers it under email fields, so sign-up codes and receipts go to your Bot." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre Bot a sa propre boîte de réception sur mail.grokbot.com. S’il n’en a pas encore, demandez-lui d’en réclamer une, puis collez l’adresse ici. Max Q la propose sous les champs e-mail, pour que les codes d’inscription et les reçus aillent à votre Bot."
          }
        }
      }
    },
    "Your Bot's address" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
